---
import type { PriceRow } from "../lib/dataAccess";

interface Props {
  prices: PriceRow[];
}

const { prices } = Astro.props;

const width = 640;
const height = 220;
const padding = 30;

let points = "";
let minClose = 0;
let maxClose = 0;
let firstDate = "";
let lastDate = "";

if (prices.length > 1) {
  const closes = prices.map((p) => p.close);
  minClose = Math.min(...closes);
  maxClose = Math.max(...closes);
  const range = maxClose - minClose || 1;
  firstDate = prices[0].date;
  lastDate = prices[prices.length - 1].date;

  points = prices
    .map((p, i) => {
      const x = padding + (i / (prices.length - 1)) * (width - padding * 2);
      const y =
        height - padding - ((p.close - minClose) / range) * (height - padding * 2);
      return `${x.toFixed(1)},${y.toFixed(1)}`;
    })
    .join(" ");
}
---

<div class="section">
  <h2>股價走勢</h2>
  {
    prices.length < 2 ? (
      <p class="empty-state">
        尚無足夠股價資料繪製走勢圖,資料會隨每次排程更新逐步累積。
      </p>
    ) : (
      <>
        <svg viewBox={`0 0 ${width} ${height}`} width="100%" role="img" aria-label="股價走勢圖">
          <polyline
            points={points}
            fill="none"
            stroke="var(--color-accent)"
            stroke-width="2"
          />
          <text x={padding} y={height - 6} font-size="11" fill="var(--color-text-muted)">
            {firstDate}
          </text>
          <text
            x={width - padding}
            y={height - 6}
            font-size="11"
            fill="var(--color-text-muted)"
            text-anchor="end"
          >
            {lastDate}
          </text>
          <text x={padding} y={14} font-size="11" fill="var(--color-text-muted)">
            {maxClose.toFixed(1)}
          </text>
          <text
            x={padding}
            y={height - padding + 14}
            font-size="11"
            fill="var(--color-text-muted)"
          >
            {minClose.toFixed(1)}
          </text>
        </svg>
        <p class="source-note">
          資料來源:TWSE 個股日成交資訊(openapi.twse.com.tw){" "}
          收盤價,共 {prices.length} 個交易日
        </p>
      </>
    )
  }
</div>
