---
import Layout from "../components/Layout.astro";
import { getAllIndustries } from "../lib/dataAccess";

const industries = getAllIndustries();
const base = import.meta.env.BASE_URL;
---

<Layout title="首頁">
  <h1 class="page-title">台灣產業供應鏈</h1>
  <p class="page-summary">
    選擇一個產業,看清楚上中下游廠商分布,點進廠商可查看公司介紹、財報與股價表現。
  </p>
  <div class="industry-grid">
    {
      industries.map((industry) => (
        <a class="industry-card" href={`${base}industry/${industry.slug}/`}>
          <h2>{industry.nameZh}</h2>
          <p>{industry.summary}</p>
        </a>
      ))
    }
  </div>
</Layout>
